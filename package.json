{
	"name": "kobob",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "next dev --webpack",
		"build": "prisma generate && next build --webpack && node scripts/migrate-production.mjs",
		"start": "next start",
		"lint": "biome lint .",
		"typecheck": "prisma generate && tsc --noEmit",
		"test": "npm run test:unit",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration",
		"test:e2e": "NODE_OPTIONS=--conditions=react-server playwright test",
		"db:generate": "prisma generate",
		"db:test:up": "docker compose -p kobob-test -f compose.test.yml up -d --wait",
		"db:test:down": "docker compose -p kobob-test -f compose.test.yml down",
		"db:test:migrate": "node --conditions=react-server --import tsx scripts/migrate-test-database.ts",
		"check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e && npm run build",
		"admin:bootstrap": "node --conditions=react-server --import tsx scripts/bootstrap-admin.ts"
	},
	"dependencies": {
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"better-auth": "1.7.15",
		"next": "16.4.3",
		"pg": "8.23.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"resend": "6.37.0",
		"server-only": "0.0.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@playwright/test": "1.64.1",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "22.20.5",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"prisma": "7.10.1",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"vitest": "4.1.12"
	},
	"type": "module"
}
