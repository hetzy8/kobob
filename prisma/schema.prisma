generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum MemberRole {
  member
  admin
}
enum MemberStatus {
  active
  revoked
}
model User {
  id            String       @id @default(cuid())
  name          String       @default("")
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          MemberRole   @default(member)
  status        MemberStatus @default(active)
  accessVersion Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
}
model Session {
  id            String   @id @default(cuid())
  token         String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  accessVersion Int
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([userId])
}
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@index([userId])
}
model Verification {
  id            String   @id @default(cuid())
  identifier    String   @unique
  value         String
  memberId      String?
  accessVersion Int?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([memberId])
}
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}
model MembershipAudit {
  id String @id @default(cuid())
  actorId String?
  targetId String
  action String
  createdAt DateTime @default(now())
}
enum ItemState {
  active
  archived
}
enum ItemVisibility {
  private
  public
}
enum ItemType {
  picture
  video
  audio
  drawing
  article
  interview
  document
  other
}
enum DateKind {
  unknown
  single
  range
}
enum DatePrecision {
  day
  month
  year
  decade
}
enum ItemOrigin {
  family
  internet
}
enum RightsStatus {
  unknown
  needs_clarification
  cleared
}
enum ReviewStatus {
  needs_review
  reviewed
}
enum MediaRole {
  original
  thumbnail
  display
}
enum MediaStatus {
  pending
  verified
  failed
}
// workingRevisionId is nullable only because the item row must exist before
// its first revision; the editorial service always sets it in the same transaction.
model Item {
  id                  String         @id @default(cuid())
  kobId               String?        @unique
  state               ItemState      @default(active)
  visibility          ItemVisibility @default(private)
  version             Int            @default(1)
  workingRevisionId   String?        @unique
  publishedRevisionId String?        @unique
  publishedAt         DateTime?
  origin              ItemOrigin     @default(family)
  rightsStatus        RightsStatus   @default(unknown)
  reviewStatus        ReviewStatus   @default(reviewed)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  revisions           ItemRevision[] @relation("ItemRevisions")
  sources             ExternalSource[]
  files               MediaFile[]
  catalogRecord       ItemCatalogRecord?
  workingRevision     ItemRevision?  @relation("WorkingRevision", fields: [workingRevisionId], references: [id])
  publishedRevision   ItemRevision?  @relation("PublishedRevision", fields: [publishedRevisionId], references: [id])
  @@index([state, visibility])
  @@index([state, reviewStatus])
}
model ItemRevision {
  id              String               @id @default(cuid())
  itemId          String
  item            Item                 @relation("ItemRevisions", fields: [itemId], references: [id], onDelete: Cascade)
  title           String
  description     String               @default("")
  types           ItemType[]
  dateKind        DateKind             @default(unknown)
  dateStart       DateTime?            @db.Date
  dateEnd         DateTime?            @db.Date
  datePrecision   DatePrecision?
  dateApproximate Boolean              @default(false)
  tags            String[]
  authorId        String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  people          ItemRevisionPerson[]
  places          ItemRevisionPlace[]
  workingFor      Item?                @relation("WorkingRevision")
  publishedFor    Item?                @relation("PublishedRevision")
  @@index([itemId])
}
model Person {
  id         String               @id @default(cuid())
  name       String
  otherNames String[]
  familyOnly Boolean              @default(false)
  version    Int                  @default(1)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  revisions  ItemRevisionPerson[]
}
model Place {
  id         String              @id @default(cuid())
  name       String
  otherNames String[]
  latitude   Float?
  longitude  Float?
  version    Int                 @default(1)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  revisions  ItemRevisionPlace[]
}
model ItemRevisionPerson {
  revisionId String
  personId   String
  revision   ItemRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  person     Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  @@id([revisionId, personId])
  @@index([personId])
}
model ItemRevisionPlace {
  revisionId String
  placeId    String
  revision   ItemRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  place      Place        @relation(fields: [placeId], references: [id], onDelete: Restrict)
  @@id([revisionId, placeId])
  @@index([placeId])
}
// Ids and action names only: never titles, descriptions or names.
model EditorialAudit {
  id         String   @id @default(cuid())
  actorId    String
  targetType String
  targetId   String
  action     String
  createdAt  DateTime @default(now())
  @@index([targetId])
}
// Public on published items: select only through archive.ts.
model ExternalSource {
  id            String  @id @default(cuid())
  itemId        String
  item          Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url           String
  publisher     String  @default("")
  author        String  @default("")
  publishedText String  @default("")
  license       String  @default("")
  @@index([itemId])
}
// Family-only. storageKey is opaque and never reaches a browser.
model MediaFile {
  id               String      @id @default(cuid())
  itemId           String
  item             Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  role             MediaRole
  storageKey       String      @unique
  mimeType         String
  sizeBytes        BigInt
  sha256           String?
  width            Int?
  height           Int?
  status           MediaStatus @default(pending)
  failureCode      String?
  originalFilename String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  @@unique([itemId, role])
  @@index([status])
}
// Family-only: the verbatim source row. Never select from a public reader.
model ItemCatalogRecord {
  id           String   @id @default(cuid())
  itemId       String   @unique
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tab          String
  row          Json
  snapshotHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
// Counts only. Row detail stays in the private report outside Git.
model ImportRun {
  id           String    @id @default(cuid())
  kind         String
  snapshotHash String
  counts       Json
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
}
